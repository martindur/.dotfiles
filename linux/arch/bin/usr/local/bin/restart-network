#!/bin/bash

# Restart network service (NetworkManager)
# Usage: restart-network

echo "Restarting network service..."

# Check if NetworkManager is installed and running
if ! systemctl is-enabled --quiet NetworkManager; then
  echo "✗ NetworkManager is not enabled"
  exit 1
fi

# Restart NetworkManager
sudo systemctl restart NetworkManager

# Wait a moment for the service to start
sleep 2

# Check status
if systemctl is-active --quiet NetworkManager; then
  echo "✓ NetworkManager restarted successfully"
else
  echo "✗ Failed to restart NetworkManager"
  exit 1
fi

# Show connection status
if command -v nmcli &> /dev/null; then
  echo ""
  echo "Current connections:"
  nmcli connection show --active
fi
