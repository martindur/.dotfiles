#!/usr/bin/env bash

# System Menu - Interactive menu for common system tasks
# Launch in a floating terminal window for quick access

set -e

# Check if fzf is installed
if ! command -v fzf &> /dev/null; then
  echo "Error: fzf is not installed"
  echo "Install with: sudo pacman -S fzf"
  exit 1
fi

# Menu options
declare -A MENU_ITEMS=(
  ["📦 Install Package (pacman)"]="pkg-install"
  ["🔧 Install AUR Package"]="pkg-aur-install"
  ["🗑️  Remove Package"]="pkg-remove"
  ["🌐 Install Webapp"]="webapp-install"
  ["❌ Remove Webapp"]="webapp-remove"
)

# Show menu with fzf
CHOICE=$(printf '%s\n' "${!MENU_ITEMS[@]}" | sort | fzf \
  --prompt="System Menu > " \
  --height=40% \
  --reverse \
  --border=rounded \
  --header="Select a system tool" \
  --color="border:#89b4fa,header:#cdd6f4,prompt:#89b4fa,pointer:#89b4fa")

# Execute based on choice
if [[ -n "$CHOICE" ]]; then
  COMMAND="${MENU_ITEMS[$CHOICE]}"
  clear
  echo "Running: $CHOICE"
  echo ""
  $COMMAND

  # Ask if user wants to return to menu
  echo ""
  read -p "Press Enter to return to menu, or Ctrl+C to exit..."
  clear
  exec "$0"  # Restart the menu
else
  exit 0
fi
