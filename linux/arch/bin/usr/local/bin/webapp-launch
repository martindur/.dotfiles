#!/bin/bash

# Launch a web app using Chromium in app mode
# Usage: webapp-launch <url>

if [ -z "$1" ]; then
  echo "Usage: webapp-launch <url>"
  exit 1
fi

URL="$1"

# Check if Chromium is installed
if ! command -v chromium &> /dev/null; then
  echo "Error: Chromium is not installed. Please install it with: sudo pacman -S chromium"
  exit 1
fi

# Launch Chromium in app mode
exec chromium --app="$URL" "${@:2}" &
