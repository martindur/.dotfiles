#!/bin/bash

# Remove a web app
# Usage: webapp-remove [app-name]

if [ -z "$1" ]; then
  # Interactive mode - show list of installed webapps
  DESKTOP_DIR="$HOME/.local/share/applications"

  if ! command -v fzf &> /dev/null; then
    echo "Error: fzf is not installed"
    exit 1
  fi

  # Find all custom .desktop files (webapps)
  mapfile -t webapps < <(find "$DESKTOP_DIR" -maxdepth 1 -name "*.desktop" -type f -exec basename {} .desktop \;)

  if [ ${#webapps[@]} -eq 0 ]; then
    echo "No webapps found"
    exit 0
  fi

  # Let user select which to remove
  APP_NAME=$(printf '%s\n' "${webapps[@]}" | fzf --prompt="Select webapp to remove> " --height=40%)

  if [ -z "$APP_NAME" ]; then
    echo "No webapp selected"
    exit 0
  fi
else
  APP_NAME="$1"
fi

DESKTOP_FILE="$HOME/.local/share/applications/$APP_NAME.desktop"
ICON_DIR="$HOME/.local/share/applications/icons"
ICON_PATH="$ICON_DIR/$APP_NAME.png"

# Remove .desktop file
if [ -f "$DESKTOP_FILE" ]; then
  rm "$DESKTOP_FILE"
  echo "✓ Removed $APP_NAME.desktop"
else
  echo "Warning: $DESKTOP_FILE not found"
fi

# Remove icon if it exists
if [ -f "$ICON_PATH" ]; then
  rm "$ICON_PATH"
  echo "✓ Removed icon for $APP_NAME"
fi

echo "✓ $APP_NAME removed successfully"
